
# Database
POSTGRES_USER={postgres_user} # نام کاربری دیتابیس  
POSTGRES_PASSWORD={postgres_password} # رمز عبور دیتابیس
POSTGRES_DB={postgres_db}

# Qdrant
QDRANT_URL={qdrant_url} # آدرس Qdrant

# API Key برای Qdrant (با دستور: openssl rand -hex 32 بسازید)
QDRANT_API_KEY={qdrant_api_key}
COLLECTION_NAME={collection_name}

# Ollama & Models
OLLAMA_URL={ollama_url}
LLM_MODEL={llm_model}       

#LLM_MODEL=partai/dorna-llama
EMBEDDING_MODEL={embedding_model}

# Document Chunking
CHUNK_SIZE={chunk_size}
CHUNK_OVERLAP={chunk_overlap}
EMBED_BATCH_SIZE={embed_batch_size}

# Redis
REDIS_HOST={redis_host}
REDIS_PORT={redis_port}

# فعال کردن رمز عبور برای ردیس
#REDIS_PASSWORD={redis_password}