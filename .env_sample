
# Database
POSTGRES_USER={postgres_user} # نام کاربری دیتابیس  
POSTGRES_PASSWORD={postgres_password} # رمز عبور دیتابیس
POSTGRES_DB={postgres_db}

# Qdrant
QDRANT_URL={qdrant_url} # آدرس Qdrant

# API Key برای Qdrant (با دستور: openssl rand -hex 32 بسازید)
QDRANT_API_KEY={qdrant_api_key}
COLLECTION_NAME={collection_name}

# Ollama & Models
OLLAMA_URL={ollama_url} # http://ollama:11434
LLM_MODEL={llm_model} # example: qwen3:8b
EMBEDDING_MODEL={embedding_model} # example: qllama/bge-m3:q4_k_m

LLM_PROVIDER=external # external|ollama
EXTERNAL_LLM_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_LLM_API_KEY=sk-xxx
EXTERNAL_LLM_MODEL=gpt-4.1-mini
EXTERNAL_LLM_FALLBACK_TO_OLLAMA=true

# Document Chunking
CHUNK_SIZE={chunk_size}
CHUNK_OVERLAP={chunk_overlap}
EMBED_BATCH_SIZE={embed_batch_size}

# Redis
REDIS_HOST={redis_host}
REDIS_PORT={redis_port}

# فعال کردن رمز عبور برای ردیس
#REDIS_PASSWORD={redis_password}
